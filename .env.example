# Copy to .env and fill in. .env is git-ignored.
OPENROUTER_API_KEY=
# Comma-separated, tried in order; run `python scripts/list_free_models.py` to see current free tool-calling models
ROADSENSE_LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# Set to 0 to run the deterministic pipeline without an LLM
ROADSENSE_USE_LLM=1

# Fine-tuned RDD2022 weights (rtdetr_l_rdd2022.pt, yolov8m_rdd2022.pt) from the training repo
ROADSENSE_WEIGHTS_DIR=weights
ROADSENSE_EDGE_WEIGHTS=yolov8m_rdd2022.pt
ROADSENSE_VERIFY_WEIGHTS=rtdetr_l_rdd2022.pt
# ROADSENSE_DEVICE=cpu

# Shared secrets between processes: change both before any non-local use
ROADSENSE_API_TOKEN=dev-token-change-me
ROADSENSE_OPEN311_API_KEY=dev-open311-key

ROADSENSE_AGENT_API_URL=http://127.0.0.1:8000
ROADSENSE_OPEN311_URL=http://127.0.0.1:8311
# 1 = use the built-in Halifax fixture instead of OpenStreetMap Nominatim
ROADSENSE_OFFLINE_GEO=0
ROADSENSE_DEDUPE_RADIUS_M=15

# LLM behaviour: live | cache (read-through cache, default) | replay (cached responses only: keyless demo)
ROADSENSE_LLM_MODE=cache
# Client-side rate limit; the free tier allows 20 requests/minute
ROADSENSE_LLM_RPM=15
# Kill switch: 0 = agents off, deterministic pipeline only
ROADSENSE_AGENTS_ENABLED=1

# Dashcam geometry for placing detections on the road (tape-measure the height; hfov from the spec sheet)
ROADSENSE_CAMERA_HEIGHT_M=1.3
ROADSENSE_CAMERA_PITCH_DEG=3.0
ROADSENSE_CAMERA_HFOV_DEG=110

# Road snapping: OSRM server and the largest correction allowed (metres)
ROADSENSE_OSRM_URL=https://router.project-osrm.org
ROADSENSE_MAX_SNAP_M=25

# ---------------- production settings (see docs/deployment.md) ----------------
# Sign-in. The first admin is created on first start; without a password one is generated into
# data/initial_admin_password.txt. ROADSENSE_AUTH=0 disables sign-in (local development only).
ROADSENSE_AUTH=1
ROADSENSE_ADMIN_EMAIL=admin@roadsense.local
ROADSENSE_ADMIN_PASSWORD=
# Random secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROADSENSE_SESSION_SECRET=
ROADSENSE_MEDIA_SECRET=
# 1 behind HTTPS (Secure cookies + HSTS)
ROADSENSE_COOKIE_SECURE=0
# Single sign-on with Microsoft Entra ID (or any OpenID Connect provider)
ROADSENSE_OIDC_ISSUER=
ROADSENSE_OIDC_CLIENT_ID=
ROADSENSE_OIDC_CLIENT_SECRET=
ROADSENSE_OIDC_REDIRECT_URL=http://127.0.0.1:7860/auth/oidc/callback
ROADSENSE_OIDC_DEFAULT_ROLE=viewer

# Public base URL of the agent API's /media/* (what the road authority's system fetches evidence photos from)
ROADSENSE_PUBLIC_URL=http://127.0.0.1:8000
ROADSENSE_MEDIA_LINK_DAYS=120

# Data residency: "ca" refuses LLM hosts not listed here and free (prompt-logging) models.
# Point OPENROUTER_BASE_URL at a Canadian, no-retention OpenAI-compatible endpoint (or a local vLLM/Ollama server).
ROADSENSE_DATA_RESIDENCY=any
ROADSENSE_RESIDENCY_LLM_HOSTS=
# OPENROUTER_BASE_URL=https://llm.example.ca/v1

# Privacy and retention
ROADSENSE_SERVER_REDACTION=1
# Optional TorchScript face/plate detector (e.g. EgoBlur, Apache-2.0) run on the unblurred damage area
ROADSENSE_EGOBLUR_WEIGHTS=
ROADSENSE_KEEP_RAW_VIDEO=0
ROADSENSE_REJECTED_MEDIA_DAYS=30
ROADSENSE_CAR_POSITION_DAYS=30
ROADSENSE_REJECTED_SUPPRESS_DAYS=90

# Delivery and scheduling
ROADSENSE_MAX_DELIVERY_ATTEMPTS=6
ROADSENSE_SCHEDULER=1
ROADSENSE_FOLLOW_UP_MINUTES=60
# Region rules and authorities as configuration (default: roadsense/core/municipalities.json)
ROADSENSE_AUTHORITIES_FILE=

# City systems. Read-only: the city's open service requests (ArcGIS FeatureServer layer, e.g. HRM's Cityworks
# service requests on its ArcGIS Hub open-data portal), for dedupe and closed-loop status
ROADSENSE_CITY_SR_LAYER_URL=
ROADSENSE_CITY_SR_WHERE=1=1
ROADSENSE_EXTERNAL_SYNC_MINUTES=30
# Write adapters (set the authority's "channel" in the directory to cityworks / arcgis)
ROADSENSE_CITYWORKS_URL=
ROADSENSE_CITYWORKS_USER=
ROADSENSE_CITYWORKS_PASSWORD=
ROADSENSE_ARCGIS_LAYER_URL=
ROADSENSE_ARCGIS_TOKEN=
# Referral packages by email (NS Public Works)
ROADSENSE_SMTP_HOST=
ROADSENSE_SMTP_PORT=587
ROADSENSE_SMTP_USER=
ROADSENSE_SMTP_PASSWORD=
ROADSENSE_SMTP_FROM=
